using System;
using System.Data.SqlClient;
using System.Drawing;
using System.Windows.Forms;

namespace Lab07_QuanLyLop
{
    public class FormQuanLyLop : Form
    {
        // ===== Chuỗi kết nối: đổi tên server nếu máy bạn khác =====
        // LocalDB (mặc định của Visual Studio): (localdb)\MSSQLLocalDB
        // SQL Server Express:                   .\SQLEXPRESS
        const string SERVER = @"(localdb)\MSSQLLocalDB";
        const string DB = "QuanLyLop";
        string connStr = "Server=" + SERVER + ";Database=" + DB + ";Integrated Security=True;";
        string masterStr = "Server=" + SERVER + ";Database=master;Integrated Security=True;";

        TextBox txtMaLop, txtTenLop, txtGVCN, txtSiSo;
        ListView lvLop;
        Button btnThem, btnSua, btnXoa, btnLamMoi;

        public FormQuanLyLop()
        {
            // ===== Form =====
            Text = "Quản lý lớp - ADO.NET";
            ClientSize = new Size(560, 460);
            StartPosition = FormStartPosition.CenterScreen;
            FormBorderStyle = FormBorderStyle.FixedSingle;
            MaximizeBox = false;

            // ===== Nhập liệu =====
            TaoLabel("Mã lớp:", 20, 23);
            txtMaLop = TaoTextBox(90, 20, 150);

            TaoLabel("Tên lớp:", 20, 58);
            txtTenLop = TaoTextBox(90, 55, 250);

            TaoLabel("GVCN:", 20, 93);
            txtGVCN = TaoTextBox(90, 90, 250);

            TaoLabel("Sĩ số:", 20, 128);
            txtSiSo = TaoTextBox(90, 125, 80);

            // ===== Các nút =====
            btnThem = TaoButton("Thêm", 20, 165);
            btnThem.Click += btnThem_Click;

            btnSua = TaoButton("Sửa", 135, 165);
            btnSua.Click += btnSua_Click;

            btnXoa = TaoButton("Xóa", 250, 165);
            btnXoa.Click += btnXoa_Click;

            btnLamMoi = TaoButton("Làm mới", 365, 165);
            btnLamMoi.Click += btnLamMoi_Click;

            // ===== ListView =====
            lvLop = new ListView();
            lvLop.Location = new Point(20, 215);
            lvLop.Size = new Size(520, 225);
            lvLop.View = View.Details;
            lvLop.FullRowSelect = true;
            lvLop.GridLines = true;
            lvLop.MultiSelect = false;
            lvLop.Columns.Add("Mã lớp", 90);
            lvLop.Columns.Add("Tên lớp", 180);
            lvLop.Columns.Add("GVCN", 170);
            lvLop.Columns.Add("Sĩ số", 60);
            lvLop.SelectedIndexChanged += lvLop_SelectedIndexChanged;
            Controls.Add(lvLop);

            Load += FormQuanLyLop_Load;
        }

        // ===== Hàm hỗ trợ tạo control =====
        private void TaoLabel(string text, int x, int y)
        {
            Label l = new Label();
            l.Text = text;
            l.Location = new Point(x, y);
            l.AutoSize = true;
            Controls.Add(l);
        }

        private TextBox TaoTextBox(int x, int y, int width)
        {
            TextBox t = new TextBox();
            t.Location = new Point(x, y);
            t.Width = width;
            Controls.Add(t);
            return t;
        }

        private Button TaoButton(string text, int x, int y)
        {
            Button b = new Button();
            b.Text = text;
            b.Location = new Point(x, y);
            b.Size = new Size(105, 32);
            Controls.Add(b);
            return b;
        }

        // ===== Khởi tạo database (chạy 1 lần lúc mở form) =====
        private void FormQuanLyLop_Load(object sender, EventArgs e)
        {
            try
            {
                KhoiTaoDatabase();
                TaiDuLieu();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Không kết nối được SQL Server!\n\n" + ex.Message +
                    "\n\nHãy kiểm tra lại biến SERVER ở đầu code.",
                    "Lỗi kết nối", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void KhoiTaoDatabase()
        {
            // 1. Tạo database nếu chưa có
            using (SqlConnection conn = new SqlConnection(masterStr))
            {
                conn.Open();
                string sql = "IF DB_ID('" + DB + "') IS NULL CREATE DATABASE " + DB;
                new SqlCommand(sql, conn).ExecuteNonQuery();
            }

            // 2. Tạo bảng + dữ liệu mẫu nếu chưa có
            using (SqlConnection conn = new SqlConnection(connStr))
            {
                conn.Open();

                string taoBang =
                    "IF OBJECT_ID('Lop', 'U') IS NULL " +
                    "CREATE TABLE Lop (" +
                    "  MaLop  NVARCHAR(10) PRIMARY KEY," +
                    "  TenLop NVARCHAR(50) NOT NULL," +
                    "  GVCN   NVARCHAR(50)," +
                    "  SiSo   INT DEFAULT 0)";
                new SqlCommand(taoBang, conn).ExecuteNonQuery();

                int soDong = (int)new SqlCommand("SELECT COUNT(*) FROM Lop", conn).ExecuteScalar();
                if (soDong == 0)
                {
                    string mau =
                        "INSERT INTO Lop VALUES (N'CNTT01', N'Công nghệ thông tin 1', N'Nguyễn Văn A', 40);" +
                        "INSERT INTO Lop VALUES (N'CNTT02', N'Công nghệ thông tin 2', N'Trần Thị B', 38);" +
                        "INSERT INTO Lop VALUES (N'TOAN01', N'Sư phạm Toán 1', N'Lê Văn C', 35);";
                    new SqlCommand(mau, conn).ExecuteNonQuery();
                }
            }
        }

        // ===== Đọc dữ liệu từ SQL đưa vào ListView =====
        private void TaiDuLieu()
        {
            lvLop.Items.Clear();

            using (SqlConnection conn = new SqlConnection(connStr))
            {
                conn.Open();
                SqlCommand cmd = new SqlCommand("SELECT MaLop, TenLop, GVCN, SiSo FROM Lop ORDER BY MaLop", conn);

                using (SqlDataReader rd = cmd.ExecuteReader())
                {
                    while (rd.Read())
                    {
                        ListViewItem item = new ListViewItem(rd["MaLop"].ToString());
                        item.SubItems.Add(rd["TenLop"].ToString());
                        item.SubItems.Add(rd["GVCN"].ToString());
                        item.SubItems.Add(rd["SiSo"].ToString());
                        lvLop.Items.Add(item);
                    }
                }
            }
        }

        // ===== Chọn 1 dòng: đưa dữ liệu lên các ô nhập =====
        private void lvLop_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (lvLop.SelectedItems.Count == 0) return;

            ListViewItem item = lvLop.SelectedItems[0];
            txtMaLop.Text = item.SubItems[0].Text;
            txtTenLop.Text = item.SubItems[1].Text;
            txtGVCN.Text = item.SubItems[2].Text;
            txtSiSo.Text = item.SubItems[3].Text;

            txtMaLop.Enabled = false;   // khóa mã lớp (khóa chính) khi đang sửa
        }

        // ===== Kiểm tra dữ liệu nhập =====
        private bool HopLe(out int siSo)
        {
            siSo = 0;

            if (txtMaLop.Text.Trim() == "" || txtTenLop.Text.Trim() == "")
            {
                MessageBox.Show("Vui lòng nhập Mã lớp và Tên lớp!");
                return false;
            }
            if (txtSiSo.Text.Trim() != "" && (!int.TryParse(txtSiSo.Text, out siSo) || siSo < 0))
            {
                MessageBox.Show("Sĩ số phải là số nguyên không âm!");
                txtSiSo.Focus();
                return false;
            }
            return true;
        }

        // ===== Thêm =====
        private void btnThem_Click(object sender, EventArgs e)
        {
            int siSo;
            if (!HopLe(out siSo)) return;

            try
            {
                using (SqlConnection conn = new SqlConnection(connStr))
                {
                    conn.Open();
                    SqlCommand cmd = new SqlCommand(
                        "INSERT INTO Lop (MaLop, TenLop, GVCN, SiSo) VALUES (@ma, @ten, @gv, @ss)", conn);
                    cmd.Parameters.AddWithValue("@ma", txtMaLop.Text.Trim());
                    cmd.Parameters.AddWithValue("@ten", txtTenLop.Text.Trim());
                    cmd.Parameters.AddWithValue("@gv", txtGVCN.Text.Trim());
                    cmd.Parameters.AddWithValue("@ss", siSo);
                    cmd.ExecuteNonQuery();
                }
                TaiDuLieu();
                LamMoiOnhap();
            }
            catch (SqlException ex)
            {
                if (ex.Number == 2627)   // trùng khóa chính
                    MessageBox.Show("Mã lớp đã tồn tại!");
                else
                    MessageBox.Show("Lỗi: " + ex.Message);
            }
        }

        // ===== Sửa =====
        private void btnSua_Click(object sender, EventArgs e)
        {
            if (lvLop.SelectedItems.Count == 0)
            {
                MessageBox.Show("Hãy chọn 1 dòng cần sửa!");
                return;
            }

            int siSo;
            if (!HopLe(out siSo)) return;

            try
            {
                using (SqlConnection conn = new SqlConnection(connStr))
                {
                    conn.Open();
                    SqlCommand cmd = new SqlCommand(
                        "UPDATE Lop SET TenLop = @ten, GVCN = @gv, SiSo = @ss WHERE MaLop = @ma", conn);
                    cmd.Parameters.AddWithValue("@ma", txtMaLop.Text.Trim());
                    cmd.Parameters.AddWithValue("@ten", txtTenLop.Text.Trim());
                    cmd.Parameters.AddWithValue("@gv", txtGVCN.Text.Trim());
                    cmd.Parameters.AddWithValue("@ss", siSo);
                    cmd.ExecuteNonQuery();
                }
                TaiDuLieu();
                LamMoiOnhap();
                MessageBox.Show("Đã cập nhật!");
            }
            catch (SqlException ex)
            {
                MessageBox.Show("Lỗi: " + ex.Message);
            }
        }

        // ===== Xóa =====
        private void btnXoa_Click(object sender, EventArgs e)
        {
            if (lvLop.SelectedItems.Count == 0)
            {
                MessageBox.Show("Hãy chọn 1 dòng cần xóa!");
                return;
            }

            string ma = lvLop.SelectedItems[0].SubItems[0].Text;
            DialogResult kq = MessageBox.Show("Bạn có chắc muốn xóa lớp " + ma + "?",
                "Xác nhận xóa", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
            if (kq != DialogResult.Yes) return;

            try
            {
                using (SqlConnection conn = new SqlConnection(connStr))
                {
                    conn.Open();
                    SqlCommand cmd = new SqlCommand("DELETE FROM Lop WHERE MaLop = @ma", conn);
                    cmd.Parameters.AddWithValue("@ma", ma);
                    cmd.ExecuteNonQuery();
                }
                TaiDuLieu();
                LamMoiOnhap();
            }
            catch (SqlException ex)
            {
                MessageBox.Show("Lỗi: " + ex.Message);
            }
        }

        private void btnLamMoi_Click(object sender, EventArgs e)
        {
            LamMoiOnhap();
        }

        private void LamMoiOnhap()
        {
            txtMaLop.Clear();
            txtTenLop.Clear();
            txtGVCN.Clear();
            txtSiSo.Clear();
            txtMaLop.Enabled = true;
            lvLop.SelectedItems.Clear();
            txtMaLop.Focus();
        }
    }

    static class Program
    {
        [STAThread]
        static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new FormQuanLyLop());
        }
    }
}
