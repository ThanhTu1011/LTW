using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Text;

namespace BT01
{
    public class HinhHoc
    {
        public double DienTich { get; set; }
        public double ChuVi { get; set; }

        public virtual void tinhDienTichChuVi()
        {
        }

        public override string ToString()
        {
            return string.Format(CultureInfo.InvariantCulture, "S = {0:F2}; P = {1:F2}", DienTich, ChuVi);
        }
    }

    public class HinhChuNhat : HinhHoc
    {
        private double mChieuDai;
        private double mChieuRong;

        public double ChieuDai
        {
            get { return mChieuDai; }
            set
            {
                if (value > 0) mChieuDai = value;
                else throw new Exception("Chieu dai am");
            }
        }

        public double ChieuRong
        {
            get { return mChieuRong; }
            set
            {
                if (value > 0) mChieuRong = value;
                else throw new Exception("Chieu rong am");
            }
        }

        public HinhChuNhat(double d = 1, double r = 0.5)
        {
            ChieuDai = d;
            ChieuRong = r;
        }

        public override void tinhDienTichChuVi()
        {
            DienTich = ChieuDai * ChieuRong;
            ChuVi = (ChieuDai + ChieuRong) * 2;
        }

        public override string ToString()
        {
            return string.Format(CultureInfo.InvariantCulture, "L = {0}, W = {1}; {2}", ChieuDai, ChieuRong, base.ToString());
        }
    }

    public class HinhTron : HinhHoc
    {
        private double mBanKinh;

        public double BanKinh
        {
            get { return mBanKinh; }
            set
            {
                if (value > 0) mBanKinh = value;
                else throw new Exception("Ban kinh am");
            }
        }

        public HinhTron()
        {
            BanKinh = 1;
        }

        public HinhTron(double r)
        {
            BanKinh = r;
        }

        public override void tinhDienTichChuVi()
        {
            DienTich = Math.PI * BanKinh * BanKinh;
            ChuVi = 2 * Math.PI * BanKinh;
        }

        public override string ToString()
        {
            return string.Format(CultureInfo.InvariantCulture, "R = {0}; {1}", BanKinh, base.ToString());
        }
    }

    internal class Program
    {
        static void Main(string[] args)
        {
            Console.OutputEncoding = Encoding.UTF8;

            // Test constructor, property, phương thức
            HinhChuNhat hcn = new HinhChuNhat(5, 3);
            hcn.tinhDienTichChuVi();
            Console.WriteLine(hcn);

            HinhTron ht = new HinhTron(2);
            ht.tinhDienTichChuVi();
            Console.WriteLine(ht);

            // Đọc file HinhHoc.txt (dòng đầu là ghi chú nên bỏ qua)
            List<HinhHoc> ds = new List<HinhHoc>();
            foreach (string line in File.ReadAllLines("HinhHoc.txt").Skip(1))
            {
                if (string.IsNullOrWhiteSpace(line)) continue;
                string[] p = line.Split(new[] { '\t' }, StringSplitOptions.RemoveEmptyEntries);

                if (p[0].Trim() == "1")
                {
                    double d = double.Parse(p[1], CultureInfo.InvariantCulture);
                    double r = double.Parse(p[2], CultureInfo.InvariantCulture);
                    ds.Add(new HinhChuNhat(d, r));
                }
                else if (p[0].Trim() == "2")
                {
                    double bk = double.Parse(p[1], CultureInfo.InvariantCulture);
                    ds.Add(new HinhTron(bk));
                }
            }

            foreach (HinhHoc h in ds) h.tinhDienTichChuVi();

            // Tìm hình theo yêu cầu
            HinhChuNhat maxHCN = ds.OfType<HinhChuNhat>().OrderByDescending(h => h.DienTich).First();
            HinhTron minHT = ds.OfType<HinhTron>().OrderBy(h => h.ChuVi).First();

            // Ghi ra output.txt
            using (StreamWriter sw = new StreamWriter("output.txt"))
            {
                sw.WriteLine("So hinh: " + ds.Count);
                sw.WriteLine("Tong dien tich: " + ds.Sum(h => h.DienTich).ToString("F2", CultureInfo.InvariantCulture));
                sw.WriteLine("Tong chu vi: " + ds.Sum(h => h.ChuVi).ToString("F2", CultureInfo.InvariantCulture));
                sw.WriteLine("Hinh chu nhat co dien tich lon nhat: " + maxHCN);
                sw.WriteLine("Hinh tron co chu vi nho nhat: " + minHT);
            }

            Console.WriteLine("Da ghi file output.txt");
            Console.ReadKey();
        }
    }
}
