using System;
using System.Drawing;
using System.Windows.Forms;

namespace Lab05_ListView
{
    public class FormListView : Form
    {
        TextBox txtMaSV, txtHoTen, txtLop;
        ListView lvSinhVien;
        Button btnThem, btnXoa, btnLamMoi;
        Label lblThongTin;

        public FormListView()
        {
            // ===== Form =====
            Text = "Bài tập ListView";
            ClientSize = new Size(520, 430);
            StartPosition = FormStartPosition.CenterScreen;
            FormBorderStyle = FormBorderStyle.FixedSingle;
            MaximizeBox = false;

            // ===== Nhập liệu =====
            TaoLabel("Mã SV:", 20, 23);
            txtMaSV = TaoTextBox(90, 20, 150);

            TaoLabel("Họ tên:", 20, 58);
            txtHoTen = TaoTextBox(90, 55, 230);

            TaoLabel("Lớp:", 20, 93);
            txtLop = TaoTextBox(90, 90, 150);

            // ===== Các nút =====
            btnThem = TaoButton("Thêm", 20, 130);
            btnThem.Click += btnThem_Click;

            btnXoa = TaoButton("Xóa", 130, 130);
            btnXoa.Click += btnXoa_Click;

            btnLamMoi = TaoButton("Làm mới", 240, 130);
            btnLamMoi.Click += btnLamMoi_Click;

            // ===== ListView =====
            lvSinhVien = new ListView();
            lvSinhVien.Location = new Point(20, 180);
            lvSinhVien.Size = new Size(480, 190);
            lvSinhVien.View = View.Details;        // hiển thị dạng bảng
            lvSinhVien.FullRowSelect = true;       // chọn cả dòng
            lvSinhVien.GridLines = true;           // kẻ ô
            lvSinhVien.MultiSelect = false;        // chỉ chọn 1 dòng
            lvSinhVien.Columns.Add("Mã SV", 100);
            lvSinhVien.Columns.Add("Họ tên", 230);
            lvSinhVien.Columns.Add("Lớp", 120);
            lvSinhVien.SelectedIndexChanged += lvSinhVien_SelectedIndexChanged;
            Controls.Add(lvSinhVien);

            // ===== Thông tin dòng đang chọn =====
            lblThongTin = new Label();
            lblThongTin.Text = "Chưa chọn dòng nào.";
            lblThongTin.ForeColor = Color.DarkBlue;
            lblThongTin.Location = new Point(20, 385);
            lblThongTin.AutoSize = true;
            Controls.Add(lblThongTin);

            // ===== Dữ liệu mẫu ban đầu =====
            ThemDong("SV001", "Nguyễn Văn A", "CNTT01");
            ThemDong("SV002", "Trần Thị B", "CNTT01");
            ThemDong("SV003", "Lê Văn C", "CNTT02");
        }

        // ===== Hàm hỗ trợ tạo control =====
        private void TaoLabel(string text, int x, int y)
        {
            Label l = new Label();
            l.Text = text;
            l.Location = new Point(x, y);
            l.AutoSize = true;
            Controls.Add(l);
        }

        private TextBox TaoTextBox(int x, int y, int width)
        {
            TextBox t = new TextBox();
            t.Location = new Point(x, y);
            t.Width = width;
            Controls.Add(t);
            return t;
        }

        private Button TaoButton(string text, int x, int y)
        {
            Button b = new Button();
            b.Text = text;
            b.Location = new Point(x, y);
            b.Size = new Size(100, 32);
            Controls.Add(b);
            return b;
        }

        // Thêm 1 dòng vào ListView
        private void ThemDong(string ma, string ten, string lop)
        {
            ListViewItem item = new ListViewItem(ma);   // cột 1
            item.SubItems.Add(ten);                     // cột 2
            item.SubItems.Add(lop);                     // cột 3
            lvSinhVien.Items.Add(item);
        }

        // ===== Sự kiện =====

        // 1. Thêm 1 item
        private void btnThem_Click(object sender, EventArgs e)
        {
            string ma = txtMaSV.Text.Trim();
            string ten = txtHoTen.Text.Trim();
            string lop = txtLop.Text.Trim();

            if (ma == "" || ten == "" || lop == "")
            {
                MessageBox.Show("Vui lòng nhập đủ Mã SV, Họ tên và Lớp!");
                return;
            }

            // Kiểm tra trùng mã
            foreach (ListViewItem it in lvSinhVien.Items)
            {
                if (it.Text == ma)
                {
                    MessageBox.Show("Mã SV đã tồn tại!");
                    txtMaSV.Focus();
                    return;
                }
            }

            ThemDong(ma, ten, lop);
            LamMoiOnhap();
        }

        // 2. Chọn 1 dòng: đưa dữ liệu lên các ô nhập
        private void lvSinhVien_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (lvSinhVien.SelectedItems.Count == 0)
            {
                lblThongTin.Text = "Chưa chọn dòng nào.";
                return;
            }

            ListViewItem item = lvSinhVien.SelectedItems[0];
            txtMaSV.Text = item.SubItems[0].Text;
            txtHoTen.Text = item.SubItems[1].Text;
            txtLop.Text = item.SubItems[2].Text;

            lblThongTin.Text = "Đang chọn dòng số " + (item.Index + 1)
                             + " / " + lvSinhVien.Items.Count;
        }

        // 3. Xóa 1 item
        private void btnXoa_Click(object sender, EventArgs e)
        {
            if (lvSinhVien.SelectedItems.Count == 0)
            {
                MessageBox.Show("Hãy chọn 1 dòng cần xóa!");
                return;
            }

            ListViewItem item = lvSinhVien.SelectedItems[0];
            DialogResult kq = MessageBox.Show(
                "Bạn có chắc muốn xóa sinh viên " + item.SubItems[1].Text + "?",
                "Xác nhận xóa", MessageBoxButtons.YesNo, MessageBoxIcon.Question);

            if (kq == DialogResult.Yes)
            {
                lvSinhVien.Items.Remove(item);
                LamMoiOnhap();
                lblThongTin.Text = "Đã xóa. Còn " + lvSinhVien.Items.Count + " dòng.";
            }
        }

        private void btnLamMoi_Click(object sender, EventArgs e)
        {
            LamMoiOnhap();
        }

        private void LamMoiOnhap()
        {
            txtMaSV.Clear();
            txtHoTen.Clear();
            txtLop.Clear();
            txtMaSV.Focus();
        }
    }

    static class Program
    {
        [STAThread]
        static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new FormListView());
        }
    }
}
